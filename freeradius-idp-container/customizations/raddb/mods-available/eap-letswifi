# Based on mods-available/eap
# Modified to only use EAP-TLS with client certs from an eso-letswifi portal (FR_IDENTITY_SOURCE=letswifi)

eap {
    # The initial EAP type requested.
    default_eap_type = tls

    # The maximum time an EAP-Session can continue for
    timer_expire = 60

    # The maximum number of ongoing EAP sessions
    max_sessions = ${max_requests}

    tls-config tls-common {
        certificate_file = ${certdir}/server.pem
        private_key_file = ${certdir}/server.key
        private_key_password = whatever # we didn't set one, intentionally
        ca_file = ${cadir}/letswifi-ca.pem # client certs' CA, not the CA that signed server.pem
        tls_min_version = "1.2"
        tls_max_version = "1.3"

        # If your AP drops packets towards the client, try reducing this.
        fragment_size = 1024
    }

    tls {
        tls = tls-common
        virtual_server = "check-eap-tls-letswifi"
    }
}
